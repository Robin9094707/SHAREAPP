<Window x:Class="RobinShare.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Robins Share" Width="1120" Height="815" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FileDrop" DragOver="FileDragOver" FontFamily="Segoe UI Variable" Icon="Assets/RobinShare.ico">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="0,0,1,0" Padding="20,32">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="⇄" FontSize="38" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><TextBlock Text="Robins Share" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Einfach. Schnell. Sicher." FontSize="11" Opacity="0.6" Margin="0,0,0,35"/>
     <Button Content="↗   Dateien senden" Click="ShowSend" Style="{StaticResource SidebarButton}"/>
     <Button Content="↓   Empfangen" Click="ShowReceive" Style="{StaticResource SidebarButton}"/>
     <Button Content="⊞   Geräte" Click="ShowDevices" Style="{StaticResource SidebarButton}"/>
     <Button Content="⚙   Einstellungen" Click="ShowSettings" Style="{StaticResource SidebarButton}"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Bottom"><TextBlock Text="●  Hintergrundmodus aktiv" Foreground="#398968" FontSize="11"/><TextBlock Text="Schließen minimiert in die&#10;Taskleiste. Beenden im Tray." FontSize="11" Opacity="0.55" Margin="0,9,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="1" Margin="34,25">
   <Border DockPanel.Dock="Bottom" Padding="0,14,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"><StackPanel><ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="Bereit zum Verbinden." FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
   <TabControl x:Name="Pages" BorderThickness="0" Background="Transparent">
    <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,15,4,20">
     <TextBlock Text="Große Dateien.&#10;Ganz einfach geteilt." FontSize="36" FontWeight="SemiBold" Margin="0,5,0,13"/><TextBlock Text="Schnell im lokalen Netzwerk, mit HTTPS-Server auch über das Internet. Unterbrochene Uploads sind fortsetzbar." Style="{StaticResource Note}"/>
     <Border Style="{StaticResource Card}" AllowDrop="True" Drop="FileDrop"><StackPanel><TextBlock Text="Dateien hierher ziehen" Style="{StaticResource Title}"/><TextBlock Text="Fotos, Videos und Dokumente in voller Qualität." Style="{StaticResource Note}"/><Button Content="Dateien auswählen" Click="ChooseFiles" HorizontalAlignment="Left"/><ItemsControl x:Name="SelectedFiles" Margin="0,14,0,10"/><Button x:Name="ClearFiles" Content="Auswahl leeren" Click="ClearSelection" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Senden an" Style="{StaticResource Title}"/><ComboBox x:Name="Target" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="8" Margin="0,8,0,13"/><WrapPanel><Button x:Name="SendButton" Content="Jetzt senden  ↗" Click="SendFiles" Style="{StaticResource PrimaryButton}"/><Button x:Name="CancelButton" Content="Übertragung pausieren" Click="Cancel" IsEnabled="False"/></WrapPanel><TextBox x:Name="ShareResults" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Visibility="Collapsed"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,15,4,20"><TextBlock Text="Für dich angekommen." FontSize="32" FontWeight="SemiBold" Margin="0,5,0,25"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Mit Code empfangen" Style="{StaticResource Title}"/><TextBox x:Name="ReceiveCode" MaxLength="6" FontSize="29" FontFamily="Consolas" Width="230" HorizontalAlignment="Left"/><Button Content="Datei finden" Click="Lookup" HorizontalAlignment="Left"/><StackPanel x:Name="Found"/></StackPanel></Border><TextBlock Text="Posteingang" Style="{StaticResource Title}"/><StackPanel x:Name="Inbox"/></StackPanel></ScrollViewer></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,15,4,20"><TextBlock Text="Alles verbunden." FontSize="32" FontWeight="SemiBold" Margin="0,5,0,25"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Über deinen Webserver koppeln" Style="{StaticResource Title}"/><TextBlock Text="Diesen Code auf dem iPhone eingeben. Zehn Minuten gültig, einmal verwendbar." Style="{StaticResource Note}"/><TextBlock x:Name="PairCode" FontSize="34" FontFamily="Consolas"/><TextBox x:Name="PeerCode" MaxLength="6" Width="230" HorizontalAlignment="Left"/><Button Content="Anderes Gerät koppeln" Click="Pair" HorizontalAlignment="Left"/><StackPanel x:Name="Peers"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Direkt im WLAN oder Hotspot" Style="{StaticResource Title}"/><TextBlock x:Name="LocalStatus" Style="{StaticResource Note}"/><TextBlock Text="Lokale Adresse" Opacity="0.6" FontSize="12"/><TextBox x:Name="LocalAddress" IsReadOnly="True"/><TextBlock Text="Lokaler Kopplungscode" Opacity="0.6" FontSize="12"/><TextBlock x:Name="LocalPairCode" FontSize="34" FontFamily="Consolas"/><Button Content="Neuen lokalen Code erzeugen" Click="RenewLocal" HorizontalAlignment="Left"/><TextBlock Text="SHA-256-Fingerabdruck · auf dem iPhone vergleichen" Opacity="0.6" FontSize="12"/><TextBox x:Name="Fingerprint" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/><TextBlock x:Name="DiscoveryStatus" Style="{StaticResource Note}"/><StackPanel x:Name="LocalPeers"/><TextBlock Text="Bluetooth erkennt den PC. Dateiinhalte laufen verschlüsselt über WLAN. Ohne gemeinsames WLAN bitte einen mobilen Hotspot verbinden." Style="{StaticResource Note}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,15,4,20"><TextBlock Text="Dein Share. Deine Regeln." FontSize="30" FontWeight="SemiBold" Margin="0,5,0,25"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Webserver" Style="{StaticResource Title}"/><TextBlock Text="HTTPS-Adresse" Opacity="0.6"/><TextBox x:Name="ServerAddress"/><TextBlock Text="Name für neue Geräteidentität" Opacity="0.6"/><TextBox x:Name="DeviceName"/><Button Content="Speichern und verbinden" Click="SaveServer" HorizontalAlignment="Left"/><Button Content="Neue Serveridentität erstellen" Click="ResetIdentity" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="In Windows integriert" Style="{StaticResource Title}"/><CheckBox x:Name="Autostart" Content="Mit Windows im Hintergrund starten" Margin="0,10"/><CheckBox x:Name="ContextIntegration" Content="Datei-Kontextmenü: An iPhone senden" Margin="0,10"/><TextBlock Text="Unter Windows 11 findest du den Eintrag gegebenenfalls unter Weitere Optionen anzeigen." Style="{StaticResource Note}"/><Button Content="Windows-Integration speichern" Click="SaveIntegration" HorizontalAlignment="Left"/><Button Content="Empfangsordner öffnen" Click="OpenDownloads" HorizontalAlignment="Left"/><Button Content="Windows-Hotspot öffnen" Click="OpenHotspot" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock Text="Robins Share 1.1.0 · native Windows-11-Fluent-Oberfläche mit Systemdesign. Unterbrochene Serveruploads werden beim nächsten Versuch fortgesetzt. iOS-Hintergrundübertragungen unterliegen den Systemgrenzen." Style="{StaticResource Note}"/></StackPanel></ScrollViewer></TabItem>
   </TabControl>
  </DockPanel>
 </Grid>
</Window>
