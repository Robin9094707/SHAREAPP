<Application x:Class="RobinShare.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown" ThemeMode="System">
 <Application.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"/><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Opacity" Value="0.65"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
 </Application.Resources>
</Application>
