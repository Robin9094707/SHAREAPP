<Window
    x:Class="RobinShare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SHAREAPP · WinUI 3">

  <Grid x:Name="AppRoot" RequestedTheme="Dark" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Real Windows 11 title bar, not a WPF imitation. -->
    <Grid x:Name="TitleBarArea" Grid.Row="0" Background="Transparent" Padding="22,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE8B7;" FontSize="17" />
        <TextBlock Text="SHAREAPP" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
        <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="7" Padding="8,3">
          <TextBlock Text="WinUI 3" FontSize="11" VerticalAlignment="Center"/>
        </Border>
      </StackPanel>
    </Grid>

    <NavigationView x:Name="SideNav" Grid.Row="1"
                    PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" IsPaneToggleButtonVisible="True"
                    OpenPaneLength="238" CompactPaneLength="56"
                    SelectionChanged="OnNavigationChanged"
                    Background="Transparent">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="SendNavItem" Tag="send" Content="Dateien teilen">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE72D;"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Tag="receive" Content="Empfangen">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Tag="devices" Content="Meine Geräte">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B2;"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemSeparator/>
        <NavigationViewItem Tag="settings" Content="Einstellungen">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid Padding="28,20,28,12">
        <ScrollViewer x:Name="SendPage" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="13" MaxWidth="900">
            <StackPanel Spacing="6" Margin="0,0,0,12">
              <TextBlock Text="Nahtlos teilen." Style="{ThemeResource TitleLargeTextBlockStyle}"/>
              <TextBlock Text="Deine Dateien. Dein Netzwerk. Jeder Empfänger." Style="{StaticResource ShareCaption}"/>
            </StackPanel>
            <Border Style="{StaticResource ShareCard}">
              <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                  <StackPanel>
                    <TextBlock Text="Dateien auswählen" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Per Explorer, Zwischenablage oder Drag &amp; Drop" Style="{StaticResource ShareCaption}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Dateien hinzufügen" Click="ChooseFiles" Style="{ThemeResource AccentButtonStyle}"/>
                  <Button Content="Ordner als ZIP" Click="ChooseFolder"/>
                  <Button Content="Einfügen" Click="PasteFiles"/>
                  <Button Content="Leeren" Click="ClearSelection" x:Name="ClearButton"/>
                </StackPanel>
                <ListView x:Name="FilesList" SelectionMode="None" MinHeight="65" MaxHeight="250"
                          Background="Transparent" BorderThickness="0">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnSpacing="13" Padding="1,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" VerticalAlignment="Center" FontSize="18"/>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource ShareCaption}" FontSize="12"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ShareCard}">
              <StackPanel Spacing="14">
                <TextBlock Text="Wohin soll die Datei?" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="Direkt im WLAN oder weltweit per HTTPS-Link." Style="{StaticResource ShareCaption}"/>
                <ComboBox x:Name="TargetCombo" Header="Empfänger" HorizontalAlignment="Stretch" DisplayMemberPath="Name" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="SendButton" Content="Sicher senden" Style="{ThemeResource AccentButtonStyle}" Click="SendFiles"/>
                  <Button x:Name="SystemShareButton" Content="Windows-Freigabe" Click="ShareThroughWindows"/>
                  <Button x:Name="CancelButton" Content="Pausieren" Click="Cancel" IsEnabled="False"/>
                </StackPanel>
                <ProgressBar x:Name="TransferProgress" Minimum="0" Maximum="100" Visibility="Collapsed" Height="5"/>
                <TextBlock x:Name="TransferCaption" Text="" Style="{StaticResource ShareCaption}"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ShareCard}">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Freigabelinks" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                  <Button Content="Kopieren" Click="CopyResults"/>
                </StackPanel>
                <TextBox x:Name="ShareResults" PlaceholderText="Nach dem Upload erscheinen hier Code und HTTPS-Link."
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" MaxHeight="180"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ReceivePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" MaxWidth="900">
            <TextBlock Text="Für dich angekommen." Style="{ThemeResource TitleLargeTextBlockStyle}" Margin="0,0,0,9"/>
            <Border Style="{StaticResource ShareCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Mit einem Code empfangen" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBox x:Name="ReceiveCode" Header="Sechsstelliger Freigabecode" MaxLength="6"
                         PlaceholderText="000000" Width="260" HorizontalAlignment="Left"/>
                <Button Content="Datei suchen" Click="Lookup" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                <StackPanel x:Name="FoundPanel" Spacing="8"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Dein Posteingang" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,9,0,0"/>
            <StackPanel x:Name="InboxPanel" Spacing="12"/>
            <Button Content="Empfangsordner öffnen" Click="OpenDownloads" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" MaxWidth="900">
            <TextBlock Text="Alles verbunden." Style="{ThemeResource TitleLargeTextBlockStyle}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource ShareCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Mit Server koppeln" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="Dein eigener Kopplungscode" Style="{StaticResource ShareCaption}"/>
                <TextBlock x:Name="PairCode" Text="– – – – – –" FontFamily="Consolas" FontSize="30" IsTextSelectionEnabled="True"/>
                <TextBox x:Name="PeerCode" Header="Code des anderen Geräts" PlaceholderText="000000" MaxLength="6"/>
                <Button Content="Koppeln" Click="Pair" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                <StackPanel x:Name="PeersPanel" Spacing="8"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource ShareCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Direkt über WLAN und Hotspot" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="LocalStatus" Text="Wird eingerichtet …" Style="{StaticResource ShareCaption}"/>
                <TextBox x:Name="LocalAddress" Header="Lokale HTTPS-Adresse" IsReadOnly="True"/>
                <TextBlock Text="Lokaler Kopplungscode" Style="{StaticResource ShareCaption}"/>
                <TextBlock x:Name="LocalPairCode" Text="– – – – – –" FontFamily="Consolas" FontSize="30" IsTextSelectionEnabled="True"/>
                <Button Content="Code erneuern" Click="RenewLocal" HorizontalAlignment="Left"/>
                <TextBox x:Name="Fingerprint" Header="PC-Fingerabdruck (SHA-256)" IsReadOnly="True" TextWrapping="Wrap"/>
                <TextBlock x:Name="DiscoveryStatus" Style="{StaticResource ShareCaption}"/>
                <StackPanel x:Name="LocalPeersPanel" Spacing="8"/>
                <Button Content="Windows-Hotspot öffnen" Click="OpenHotspot" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" MaxWidth="900">
            <TextBlock Text="Dein Share. Deine Regeln." Style="{ThemeResource TitleLargeTextBlockStyle}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource ShareCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Darstellung" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="Native WinUI-3-Steuerelemente, Windows-11-Mica und Systemfarben." Style="{StaticResource ShareCaption}"/>
                <ComboBox x:Name="ThemeCombo" Header="Design" Width="250" HorizontalAlignment="Left" SelectionChanged="ChangeTheme">
                  <ComboBoxItem Content="Dunkel" Tag="Dark"/>
                  <ComboBoxItem Content="Hell" Tag="Light"/>
                  <ComboBoxItem Content="System" Tag="Default"/>
                </ComboBox>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource ShareCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Verbindung" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBox x:Name="ServerAddress" Header="HTTPS-Serveradresse" PlaceholderText="https://share.rjuhas.eu"/>
                <TextBox x:Name="DeviceName" Header="Gerätename"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Verbinden und speichern" Click="SaveServer" Style="{ThemeResource AccentButtonStyle}"/>
                  <Button Content="Neue Identität" Click="ResetIdentity"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource ShareCard}">
              <StackPanel Spacing="12">
                <TextBlock Text="Windows-Integration" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <ToggleSwitch x:Name="AutoStart" Header="Beim Anmelden im Hintergrund starten"/>
                <ToggleSwitch x:Name="ContextIntegration" Header="Explorer-Kontextmenü aktivieren"/>
                <Button Content="Windows-Integration speichern" Click="SaveIntegration" HorizontalAlignment="Left"/>
                <TextBlock Text="Version 3.1 · echtes WinUI 3 · sichere lokale HTTPS-Übertragung · Windows App SDK"
                           Style="{StaticResource ShareCaption}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </NavigationView>

    <InfoBar x:Name="StatusInfo" Grid.Row="2" IsOpen="True" IsClosable="False"
             Severity="Informational" Title="Robins Share"
             Message="Bereit zum Verbinden." Margin="16,4,16,12"/>
  </Grid>
</Window>